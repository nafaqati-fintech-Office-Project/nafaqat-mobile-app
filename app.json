{
  "expo": {
    "name": "Nafaqati",
    "slug": "nafaqati-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nafaqati",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d04820ad-5757-4f0a-acd8-9cee9e223e33"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.intellivex.nafaqati",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "ar"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.intellivex.nafaqati",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060B2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Nafaqati uses the camera so you can photograph a receipt or bill to add it as an expense.",
          "photosPermission": "Nafaqati reads the receipt or bill photo you choose to add it as an expense.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nafaqati uses the microphone so you can ask the assistant questions by voice.",
          "speechRecognitionPermission": "Nafaqati turns your voice into text so you can ask the assistant questions.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      "./plugins/withNafaqatiShortcuts"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d04820ad-5757-4f0a-acd8-9cee9e223e33"
      }
    }
  }
}
