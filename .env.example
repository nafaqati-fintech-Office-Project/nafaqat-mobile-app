# Gateway base URL (port 8080). Pick the line that matches where the app runs.
# Android emulator:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
# iOS simulator:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# Physical device (same Wi-Fi as the backend machine):
# EXPO_PUBLIC_API_BASE_URL=http://<LAN-IP>:8080

# Demo mode: skip real login and use a mock session + mock dashboard. Off when unset; set true only for demos.
EXPO_PUBLIC_AUTH_BYPASS=true
# Debug: make the mock dashboard request fail (shows the error state).
# EXPO_PUBLIC_DASHBOARD_MOCK_FAIL=true

# Categorizer model API (uvicorn main:app --host 0.0.0.0 --port 8087).
# Signed in, the app reaches it through the gateway (/api/ai-service/**); this URL is used only
# in auth bypass. USB device: run `adb reverse tcp:8087 tcp:8087` and keep the default below.
# Emulator: http://10.0.2.2:8087. Wi-Fi device: http://<LAN-IP>:8087

# "Continue with Google": the OAuth Web client id (same value as GOOGLE_CLIENT_IDS in auth-service).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-abc.apps.googleusercontent.com
