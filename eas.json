{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.tgdplanet.cloud",
        "EXPO_PUBLIC_AUTH_BYPASS": "false",
        "EXPO_PUBLIC_MERCHANT_FALLBACK": "true",
        "EXPO_PUBLIC_LLM_ONLY": "false",
        "EXPO_PUBLIC_SMS_TOOLS": "true",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "404671155668-itgdd1chld7be7umbjgtm92471cl1ung.apps.googleusercontent.com"
      }
    },
    "production": {
      "environment": "production",
      "distribution": "internal",
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_AUTH_BYPASS": "false",
        "EXPO_PUBLIC_MERCHANT_FALLBACK": "false",
        "EXPO_PUBLIC_LLM_ONLY": "false",
        "EXPO_PUBLIC_SMS_TOOLS": "true"
      }
    },
    "production-store": {
      "extends": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production-store": {
      "android": {
        "track": "internal"
      }
    }
  }
}
